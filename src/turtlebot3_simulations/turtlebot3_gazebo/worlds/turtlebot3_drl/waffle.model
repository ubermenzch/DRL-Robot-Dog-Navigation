<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>

      <update_rate>1.0</update_rate>
    </plugin>

    <!-- <include>
      <uri>model://ground_plane</uri>
    </include> -->

    <model name='ground_plane'>
    <static>true</static>
    <link name='link'>
      <collision name='collision'>
        <geometry>
          <plane>
            <!-- normal定义了平面的朝向, 0 0 1 表示Z轴向上 -->
            <normal>0 0 1</normal>
            <!-- size定义了平面的尺寸(米), 改这里可以把地面变大变小 -->
            <size>100 100</size> 
          </plane>
        </geometry>
        <surface>
          <friction>
            <!-- 修改物理属性：摩擦力 -->
            <ode>
              <mu>100</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
          <contact>
              <ode>
                  <!-- 修改物理属性: 柔软度等 -->
                  <kp>1e+13</kp>
                  <kd>1</kd>
              </ode>
          </contact>
          <bounce>
              <!-- 修改物理属性：弹力 -->
              <restitution_coefficient>0</restitution_coefficient>
              <threshold>1e+06</threshold>
          </bounce>
        </surface>
      </collision>
      <visual name='visual'>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <!-- 视觉尺寸要和物理尺寸保持一致 -->
            <size>100 100</size>
          </plane>
        </geometry>
        <material>
          <!-- 修改外观：使用Gazebo内置的带格子的灰色纹理 -->
          <script>
            <uri>file://media/materials/scripts/gazebo.material</uri>
            <name>Gazebo/Grey</name>
          </script>
          <!-- 如果想用纯色，可以注释掉上面的<script>，用下面的<ambient> -->
          <!-- 
          <ambient>0.0 0.5 0.0 1.0</ambient>  (R, G, B, Alpha) 这是一个绿色
          <diffuse>0.0 0.5 0.0 1.0</diffuse>
          -->
        </material>
      </visual>
    </link>
  </model>

    <include>
      <uri>model://sun</uri>
    </include>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- 机器人放在大地面左下角区域，远离大部分障碍物 -->
    <include>
      <uri>model://turtlebot3_waffle</uri>
      <pose>-30.0 -30.0 1.0 0 0 0</pose>
    </include>

    <include>
      <uri>model://20by20</uri>
    </include>

    <!-- 25 个圆柱障碍物：全部放在围墙外（围墙边界约±10.075），分布在四个象限 -->
    <!-- 左下象限 (x < -12, y < -12) -->
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle1</name>
      <pose>-25.0 -25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle2</name>
      <pose>-20.0 -25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle3</name>
      <pose>-15.0 -25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle4</name>
      <pose>-25.0 -20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle5</name>
      <pose>-20.0 -20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle6</name>
      <pose>-15.0 -20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle7</name>
      <pose>-25.0 -15.0 0.0 0 0 0</pose>
    </include>

    <!-- 右下象限 (x > 12, y < -12) -->
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle8</name>
      <pose>15.0 -25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle9</name>
      <pose>20.0 -25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle10</name>
      <pose>25.0 -25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle11</name>
      <pose>15.0 -20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle12</name>
      <pose>20.0 -20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle13</name>
      <pose>25.0 -20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle14</name>
      <pose>15.0 -15.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle15</name>
      <pose>20.0 -15.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle16</name>
      <pose>25.0 -15.0 0.0 0 0 0</pose>
    </include>

    <!-- 左上象限 (x < -12, y > 12) -->
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle17</name>
      <pose>-25.0 15.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle18</name>
      <pose>-20.0 15.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle19</name>
      <pose>-15.0 15.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle20</name>
      <pose>-25.0 20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle21</name>
      <pose>-20.0 20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle22</name>
      <pose>-15.0 20.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle23</name>
      <pose>-25.0 25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle24</name>
      <pose>-20.0 25.0 0.0 0 0 0</pose>
    </include>
    <include>
      <uri>model://obstacle5</uri>
      <name>obstacle25</name>
      <pose>-15.0 25.0 0.0 0 0 0</pose>
    </include>

    <!-- 目标模型（绿色圆柱体），用于可视化终点位置：放在大地面的右上角区域 -->
    <include>
      <uri>model://goal_cylinder</uri>
      <!-- 显式设置终点位姿，放在更远处的地面上 -->
      <pose>30.0 30.0 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>
